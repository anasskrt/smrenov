---
// En-tête des pages intérieures : fil d'Ariane, titre H1, introduction, actions et photo optionnelle.
import type { ImageMetadata } from 'astro';
import CotedPhoto from './CotedPhoto.astro';

interface Props {
	title: string;
	lead: string;
	crumbs: { label: string; href?: string }[];
	photo?: { label: string; width: number; height: number; image?: ImageMetadata; alt?: string; focus?: string };
}

const { title, lead, crumbs, photo } = Astro.props;
---

<section class:list={['phero on-dark', { 'phero--photo': photo }]} aria-labelledby="page-title" data-hero>
	<div class="container phero__grid">
		<div class="phero__text">
			<nav aria-label="Fil d'Ariane">
				<ol class="crumbs" role="list">
					{
						crumbs.map((crumb) => (
							<li>
								{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
							</li>
						))
					}
				</ol>
			</nav>
			<h1 id="page-title">{title}</h1>
			<p class="phero__lead">{lead}</p>
			{
				Astro.slots.has('actions') && (
					<div class="phero__actions">
						<slot name="actions" />
					</div>
				)
			}
		</div>

		{photo && <CotedPhoto {...photo} />}
	</div>
</section>

<style>
	.phero {
		background: var(--night);
		padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
		overflow: hidden;
	}

	.phero__grid {
		display: grid;
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.phero--photo .phero__grid {
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		margin-bottom: 1.75rem;
		font-size: 0.875rem;
		color: var(--fg-soft);
	}

	.crumbs li:not(:last-child)::after {
		content: '/';
		margin-inline: 0.625rem;
		opacity: 0.5;
	}

	.crumbs a {
		text-decoration: none;
	}

	.crumbs a:hover {
		color: var(--fg);
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.crumbs [aria-current] {
		color: var(--fg);
	}

	h1 {
		max-width: 18ch;
		font-size: clamp(2.125rem, 1.3rem + 2.8vw, 4rem);
		font-stretch: 125%;
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.phero__lead {
		margin-top: 1.5rem;
		max-width: 46ch;
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
		line-height: 1.45;
		color: var(--fg-soft);
	}

	.phero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	@media (max-width: 700px) {
		.phero--photo .phero__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.phero__actions :global(.btn) {
			flex: 1 1 100%;
		}
	}
</style>
