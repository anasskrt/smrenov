---
// Emplacement photo provisoire (cadre rouge).
// À remplacer par <Image /> d'astro:assets quand les vraies photos seront fournies.
// Le parent peut ajuster le rendu via les variables --ph-ratio et --ph-pos.
interface Props {
	label: string;
	ratio?: string;
}

const { label, ratio = '4 / 3' } = Astro.props;
---

<div class="ph" style={`--ph-default-ratio: ${ratio}`} role="img" aria-label={`Emplacement photo : ${label}`}>
	<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
		<rect x="3" y="4" width="18" height="16" rx="1"></rect>
		<circle cx="9" cy="9.5" r="1.75"></circle>
		<path d="m4 18 5.5-5.5 4 4 2.5-2.5 4 4"></path>
	</svg>
	<span aria-hidden="true">{label}</span>
</div>

<style>
	.ph {
		position: var(--ph-pos, relative);
		inset: 0;
		width: 100%;
		height: 100%;
		aspect-ratio: var(--ph-ratio, var(--ph-default-ratio));
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		padding: 1.25rem;
		background: var(--ph-fill);
		outline: 1.5px dashed var(--ph);
		outline-offset: -1.5px;
		color: var(--ph-ink);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.35;
		text-align: center;
		text-wrap: balance;
	}

	svg {
		width: 1.75rem;
		height: 1.75rem;
		opacity: 0.8;
	}

	span {
		max-width: 26ch;
	}
</style>
