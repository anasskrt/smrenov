---

<svg
	class="service-icon"
	viewBox="0 0 48 48"
	width="48"
	height="48"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	aria-hidden="true"
	set:html={drawings[name] ?? ''}
/>

<style>
	.service-icon {
		width: 100%;
		height: auto;
	}
</style>
