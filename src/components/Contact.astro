---
import Icon from './Icon.astro';
import { site, isTodo } from '../data/site';
---

<section id="devis" class="contact on-dark" aria-labelledby="contact-title">
	<div class="container contact__grid">
		<div>
			<h2 id="contact-title" class="title">Demandez votre devis gratuit</h2>
			<p class="lead contact__lead">
				Laissez votre téléphone et votre email : nous vous rappelons pour parler de votre projet et convenir d'une
				visite pour prendre les cotes.
			</p>

			<ul class="contact__list" role="list">
				<li>
					<Icon name="phone" />
					<div>
						<span class="contact__label">Téléphone</span>
						<a href={site.phoneHref} class:list={{ todo: isTodo(site.phone) }}>{site.phone}</a>
					</div>
				</li>
				<li>
					<Icon name="chat" />
					<div>
						<span class="contact__label">WhatsApp</span>
						<a href={site.whatsappHref} target="_blank" rel="noopener">Écrire sur WhatsApp</a>
					</div>
				</li>
				<li>
					<Icon name="mail" />
					<div>
						<span class="contact__label">Email</span>
						<a href={site.emailHref} class:list={{ todo: isTodo(site.email) }}>{site.email}</a>
					</div>
				</li>
				<li>
					<Icon name="pin" />
					<div>
						<span class="contact__label">Adresse</span>
						<p>{site.address}, {site.postalCode} {site.addressCity}</p>
					</div>
				</li>
			</ul>
		</div>

		<form
			class="form on-light"
			method="post"
			action={site.formEndpoint || undefined}
			data-endpoint={site.formEndpoint}
			data-devis-form
		>
			<div class="form__grid">
				<div class="field">
					<label for="f-tel">Téléphone</label>
					<input id="f-tel" name="telephone" type="tel" autocomplete="tel" inputmode="tel" required />
				</div>
				<div class="field">
					<label for="f-email">Email</label>
					<input id="f-email" name="email" type="email" autocomplete="email" required />
				</div>
			</div>

			<!-- Champ piège anti-spam : invisible pour les visiteurs -->
			<div class="form__trap" aria-hidden="true">
				<label for="f-gotcha">Ne pas remplir</label>
				<input id="f-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
			</div>

			<label class="consent">
				<input type="checkbox" name="consentement" required />
				<span>
					J'accepte que {site.name} utilise ces informations pour me recontacter au sujet de ma demande.{' '}
					<a href="/mentions-legales/#donnees-personnelles">En savoir plus sur vos données</a>
				</span>
			</label>

			<div class="form__footer">
				<button class="btn" type="submit">Envoyer ma demande</button>
				<p class="form__status" role="status" aria-live="polite" data-status></p>
			</div>
		</form>
	</div>
</section>

<style>
	.contact {
		padding-block: var(--section);
		background: var(--night);
	}

	.contact__grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.contact__lead {
		margin-top: 1.5rem;
	}

	.contact__list {
		margin-top: 2.5rem;
		border-top: 1px solid var(--rule);
	}

	.contact__list li {
		display: grid;
		grid-template-columns: 1.25rem minmax(0, 1fr);
		gap: 1rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--rule);
	}

	.contact__list svg {
		width: 1.25rem;
		height: 1.25rem;
		margin-top: 0.15rem;
		color: var(--fg-soft);
	}

	.contact__label {
		display: block;
		font-size: 0.875rem;
		color: var(--fg-soft);
	}

	.contact__list a,
	.contact__list p {
		font-size: 1.125rem;
		font-weight: 600;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	/* Formulaire ------------------------------------------------------------ */
	.form {
		padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
		background: var(--white);
	}

	.form__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.field {
		display: grid;
		gap: 0.5rem;
	}

	label {
		font-size: 0.9375rem;
		font-weight: 600;
	}

	input {
		width: 100%;
		min-height: 3.125rem;
		padding: 0.75rem 0.875rem;
		border: 1px solid #b4bdd0;
		border-radius: var(--radius);
		background: var(--white);
		font-size: 1rem;
		transition: border-color 0.15s;
	}

	input:hover {
		border-color: var(--ink-soft);
	}

	input:focus-visible {
		outline: 2px solid var(--night);
		outline-offset: 0;
		border-color: var(--night);
	}

	input:user-invalid {
		border-color: var(--todo);
	}

	::placeholder {
		color: #8a93a8;
	}

	.form__trap {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.consent {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.75rem;
		margin-top: 1.5rem;
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--fg-soft);
		cursor: pointer;
	}

	.consent a {
		color: var(--fg);
	}

	.consent input {
		width: 1.125rem;
		height: 1.125rem;
		min-height: 0;
		margin: 0.15rem 0 0;
		padding: 0;
		accent-color: var(--night);
	}

	.form__footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.75rem;
	}

	.form__status {
		flex: 1 1 16rem;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.form__status:empty {
		display: none;
	}

	.form__status.is-success {
		color: #1a7a45;
	}

	.form__status.is-error {
		color: var(--todo);
	}

	@media (max-width: 900px) {
		.contact__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.form {
			margin-inline: calc(-1 * var(--gutter));
		}

		.form__grid {
			grid-template-columns: 1fr;
		}

		.form__footer .btn {
			width: 100%;
		}
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-devis-form]');
	const status = form?.querySelector<HTMLElement>('[data-status]');

	const setStatus = (message: string, state: 'success' | 'error' | 'todo') => {
		if (!status) return;
		status.textContent = message;
		status.className = `form__status ${state === 'todo' ? 'todo' : `is-${state}`}`;
	};

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const endpoint = form.dataset.endpoint;
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const data = new FormData(form);

		// Robot détecté : on simule un envoi réussi sans rien transmettre.
		if (data.get('_gotcha')) {
			form.reset();
			setStatus('Demande envoyée. Nous vous recontactons pour convenir d’une visite.', 'success');
			return;
		}

		if (!endpoint) {
			setStatus('[À COMPLÉTER : brancher l’envoi du formulaire (Formspree, Web3Forms…)]', 'todo');
			return;
		}

		if (button) {
			button.disabled = true;
			button.textContent = 'Envoi en cours…';
		}

		try {
			const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
			if (!response.ok) throw new Error(String(response.status));
			form.reset();
			setStatus('Demande envoyée. Nous vous recontactons pour convenir d’une visite.', 'success');
		} catch {
			setStatus('L’envoi a échoué. Réessayez dans un instant ou appelez-nous directement.', 'error');
		} finally {
			if (button) {
				button.disabled = false;
				button.textContent = 'Envoyer ma demande';
			}
		}
	});
</script>
