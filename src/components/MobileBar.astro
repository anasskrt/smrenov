---
// Barre d'action fixe sur mobile : visible une fois le hero passé, masquée sur le formulaire de devis.
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
	devisHref?: string;
}

const { devisHref = '#devis' } = Astro.props;
---

<div class="mbar on-dark" data-mbar>
	<a class="btn btn--ghost" href={site.phoneHref}><Icon name="phone" />Appeler</a>
	<a class="btn" href={devisHref}>Devis gratuit</a>
</div>

<style>
	.mbar {
		display: none;
	}

	@media (max-width: 719px) {
		.mbar {
			position: fixed;
			inset: auto 0 0;
			z-index: 30;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.625rem;
			padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
			background: var(--night);
			border-top: 1px solid var(--rule);
			transform: translateY(100%);
			visibility: hidden;
			transition:
				transform 0.3s ease,
				visibility 0.3s;
		}

		.mbar.is-visible {
			transform: none;
			visibility: visible;
		}

		.mbar .btn {
			min-height: 3rem;
			padding-inline: 1rem;
		}

		:global(body) {
			padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
		}
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>('[data-mbar]');
	const hero = document.querySelector('[data-hero]');
	const devis = document.getElementById('devis');

	let heroVisible = Boolean(hero);
	let devisVisible = false;
	const update = () => bar?.classList.toggle('is-visible', !heroVisible && !devisVisible);

	if (bar) {
		if (hero) {
			new IntersectionObserver(([entry]) => {
				heroVisible = entry.isIntersecting;
				update();
			}).observe(hero);
		}
		if (devis) {
			new IntersectionObserver(
				([entry]) => {
					devisVisible = entry.isIntersecting;
					update();
				},
				{ threshold: 0.1 },
			).observe(devis);
		}
		update();
	}
</script>
