---
import Icon from './Icon.astro';
import { site, steps } from '../data/site';
---

<section class="cta on-dark" aria-labelledby="cta-title">
	<div class="container">
		<div class="cta__top">
			<h2 id="cta-title" class="cta__title">Votre projet commence par une prise de cotes.</h2>
			<div class="cta__side">
				<p>
					Appelez-nous ou décrivez votre projet en ligne&nbsp;: nous passons chez vous mesurer vos ouvertures,
					puis vous recevez un devis détaillé et gratuit.
				</p>
				<div class="cta__actions">
					<a class="btn" href="#devis">Demander un devis gratuit</a>
					<a class="btn btn--ghost" href={site.phoneHref}><Icon name="phone" />Appeler</a>
				</div>
			</div>
		</div>

		<ol class="steps" role="list" aria-label="Déroulement d'un chantier">
			{
				steps.map((step, i) => (
					<li>
						<span class="steps__n" aria-hidden="true">{i + 1}</span>
						<strong>{step.title}</strong>
						<span class="steps__text">{step.text}</span>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.cta {
		background: var(--black);
		padding-block: clamp(4.5rem, 3rem + 5vw, 7rem) clamp(3.5rem, 2.5rem + 3vw, 5rem);
	}

	.cta__top {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 2.5rem 5rem;
		align-items: end;
	}

	.cta__title {
		max-width: 15ch;
		font-size: clamp(2.25rem, 1.2rem + 3.8vw, 4.375rem);
		font-stretch: 125%;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.cta__side p {
		color: var(--fg-soft);
		max-width: 44ch;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-top: clamp(3.5rem, 6vw, 5.5rem);
		border-top: 1px solid var(--rule);
	}

	.steps li {
		display: grid;
		align-content: start;
		gap: 0.375rem;
		padding: 1.75rem 1.5rem 0 0;
	}

	.steps li:not(:first-child) {
		padding-left: 1.5rem;
		border-left: 1px solid var(--rule);
	}

	.steps__n {
		margin-bottom: 1rem;
		font-size: 2.25rem;
		font-stretch: 125%;
		font-weight: 300;
		line-height: 1;
		color: var(--fg-soft);
		font-variant-numeric: tabular-nums;
	}

	.steps strong {
		font-weight: 600;
	}

	.steps__text {
		font-size: 0.9375rem;
		color: var(--fg-soft);
	}

	@media (max-width: 900px) {
		.cta__top {
			grid-template-columns: 1fr;
		}

		.steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.steps li:nth-child(odd) {
			padding-left: 0;
			border-left: 0;
		}

		.steps li:nth-child(n + 3) {
			margin-top: 1.75rem;
			border-top: 1px solid var(--rule);
		}
	}

	@media (max-width: 560px) {
		.cta__actions .btn {
			flex: 1 1 100%;
		}

		.steps {
			grid-template-columns: 1fr;
			border-top: 0;
		}

		.steps li:nth-child(n) {
			grid-template-columns: 2.5rem 1fr;
			column-gap: 1rem;
			margin-top: 0;
			padding: 1.25rem 0;
			border-left: 0;
			border-top: 1px solid var(--rule);
		}

		.steps__n {
			grid-row: span 2;
			margin: 0;
			font-size: 1.75rem;
		}
	}
</style>
