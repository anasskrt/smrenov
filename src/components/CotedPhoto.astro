---
// Photo d'en-tête (accueil et pages de prestation).
// `width` / `height` fixent la proportion du cadre ; la photo y est recadrée.
// Sans `image`, un emplacement photo provisoire est affiché à la place.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
	label: string;
	width?: number;
	height?: number;
	image?: ImageMetadata;
	alt?: string;
	focus?: string;
}

const { label, width = 1450, height = 2150, image, alt = label, focus } = Astro.props;
const mm = (n: number) => n.toLocaleString('fr-FR').replace(/\s/g, ' ');
---

<figure class="coted" style={`--r: ${width / height}`}>
	<div class="coted__photo">
		{
			image ? (
				<Image
					class="coted__img"
					src={image}
					alt={alt}
					widths={[480, 800, 1200]}
					sizes="(max-width: 700px) 90vw, 34rem"
					loading="eager"
					fetchpriority="high"
					style={`--ratio: ${width} / ${height}${focus ? `; --focus: ${focus}` : ''}`}
				/>
			) : (
				<ImagePlaceholder label={label} ratio={`${width} / ${height}`} />
			)
		}
	</div>
</figure>

<style>
	.coted {
		--max-h: 34rem;
		display: grid;
		grid-template-columns: min(100%, calc(var(--max-h) * var(--r)));
		justify-content: var(--coted-align, end);
		width: 100%;
	}

	.coted__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: var(--ratio);
		object-fit: cover;
		object-position: var(--focus, center);
	}

	@media (max-width: 700px) {
		.coted {
			--max-h: 26rem;
			--coted-align: start;
		}
	}
</style>
