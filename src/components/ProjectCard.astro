---
// Carte d'une réalisation : photo (+ vignette « avant » éventuelle), titre, commune et lien vers la prestation.
// Le parent peut ajuster le cadrage via --ph-ratio, --ph-pos, --pcard-flex et --pcard-min-h.
import { Image } from 'astro:assets';
import { serviceBySlug } from '../data/services';
import { isTodo } from '../data/site';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	showService?: boolean;
}

const { project, showService = true } = Astro.props;
const service = serviceBySlug(project.service);
const where = isTodo(project.place) ? '' : ` à ${project.place}`;
const sizes = '(max-width: 560px) 90vw, (max-width: 1023px) 50vw, 40vw';
---

<figure class="pcard">
	<div class="pcard__media">
		<Image
			class="pcard__img"
			src={project.image}
			alt={`${project.title}${where}, réalisation smrenov24`}
			widths={[480, 800, 1200]}
			sizes={sizes}
			style={project.focus ? `--focus: ${project.focus}` : undefined}
		/>
		{
			project.before && (
				<div class="pcard__before">
					<Image class="pcard__before-img" src={project.before} alt={`Avant les travaux : ${project.title.toLowerCase()}`} widths={[240, 400]} sizes="160px" />
					<span>Avant</span>
				</div>
			)
		}
	</div>
	<figcaption>
		<strong>{project.title}</strong>
		<span class:list={['pcard__place', { todo: isTodo(project.place) }]}>{project.place}</span>
		{
			showService && service && (
				<a class="pcard__service" href={`/prestations/${service.slug}/`}>
					{service.shortTitle}
				</a>
			)
		}
	</figcaption>
</figure>

<style>
	.pcard {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.pcard__media {
		position: relative;
		flex: var(--pcard-flex, none);
		min-height: var(--pcard-min-h, 0);
	}

	/* Mêmes variables que l'emplacement photo provisoire (--ph-ratio, --ph-pos) */
	.pcard__img {
		position: var(--ph-pos, relative);
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: var(--ph-ratio, 4 / 3);
		object-fit: cover;
		object-position: var(--focus, center);
		background: var(--mist);
	}

	.pcard__before {
		position: absolute;
		left: 0.75rem;
		bottom: 0.75rem;
		width: clamp(4.5rem, 28%, 9rem);
		border: 3px solid var(--white);
		box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.25);
	}

	.pcard__before-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
	}

	.pcard__before span {
		position: absolute;
		top: 0;
		left: 0;
		padding: 0.125rem 0.375rem;
		background: var(--white);
		color: var(--night);
		font-size: 0.75rem;
		font-weight: 600;
	}

	figcaption {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 0.25rem 1rem;
		padding-top: 0.875rem;
		font-size: 0.9375rem;
	}

	strong {
		font-weight: 600;
	}

	.pcard__place {
		color: var(--fg-soft);
		white-space: nowrap;
	}

	.pcard__place.todo {
		color: var(--todo);
	}

	.pcard__service {
		grid-column: 1 / -1;
		justify-self: start;
		font-size: 0.875rem;
		color: var(--fg-soft);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	.pcard__service:hover {
		color: var(--fg);
	}
</style>
